{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI 작업실 고객 로컬 프로필",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "os",
    "securitySoftware",
    "studentDataPaths",
    "workflow"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "os": {
      "enum": [
        "windows",
        "macos"
      ]
    },
    "securitySoftware": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "studentDataPaths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "고객이 로컬에서 적는 차단 대상 절대 경로. 판매자 AI에 공유하지 않음."
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "template"
      ],
      "properties": {
        "code": {
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "E"
          ]
        },
        "template": {
          "enum": [
            "A.md",
            "B.md",
            "C.md",
            "D.md",
            "E.md"
          ]
        }
      }
    },
    "workspacePath": {
      "type": "string",
      "minLength": 1,
      "description": "선택 비식별 작업실 절대 경로. 생략하면 고객 홈/AI작업실. 학생 폴더와 포함 관계이면 거부."
    }
  }
}
